# ─────────────────────────────────────────────────────────────
# IntelliMeet Frontend — Environment Variables (Create React App)
# Copy this file to .env and fill in your actual values.
# All variables MUST start with REACT_APP_ to be available in the browser.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Backend API ───────────────────────────────────────────────
# Base URL of the Express backend (no trailing slash)
# Local:      http://localhost:8000/api
# Production: https://intellimeet-s1s6.onrender.com/api
REACT_APP_API_URL=http://localhost:8000/api

# ── ZegoCloud ─────────────────────────────────────────────────
# ZegoCloud App ID (numeric) — from ZegoCloud console
REACT_APP_ZEGO_APP_ID=your_zego_app_id_here

# ZegoCloud Server Secret — used to generate test tokens locally
REACT_APP_ZEGO_SERVER_SECRET=your_zego_server_secret_here
